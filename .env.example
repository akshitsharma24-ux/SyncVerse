# Copy to .env (git-ignored) and fill in. Never commit real values.
PORT=4000

# Lane B - Judge0 (hosted key or any reachable endpoint)
JUDGE0_URL=https://ce.judge0.com   # the free public instance: no key needed
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Lane C - LLM (provider-agnostic adapter: use any provider that can return JSON; put its key and model names here)
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# Lane A - LiveKit Cloud (keys come from Lane D's P-D0)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
