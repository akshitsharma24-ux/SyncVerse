# Copy to .env (git-ignored) and fill in. Never commit real values.
PORT=4000

# Lane B - Judge0 (hosted key or any reachable endpoint)
JUDGE0_URL=https://ce.judge0.com   # the free public instance: no key needed
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Lane C - Gemini AI tutor (server only; never put the key in web code)
LLM_API_KEY=
LLM_MODEL_FAST=gemini-3.8-flash
LLM_MODEL_STRONG=gemini-3.1-pro-preview

# Lane A - LiveKit Cloud (keys come from Lane D's P-D0)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Accounts and operations. Use a random, stable secret on a hosted service.
AUTH_SECRET=
REQUIRE_AUTH=0
ADMIN_TOKEN=
LOG_LEVEL=info
LOG_TO_FILE=1
LOG_RETENTION_DAYS=7

# Optional storage overrides; defaults are under server/data locally.
# On Render, set BOTH paths to the mounted disk (see render.yaml).
# SYNCVERSE_DATA_DIR=/var/data/syncverse
# COLLAB_DATA_DIR=/var/data/syncverse/rooms
# npm start enables production mode; production requires a sandboxed JUDGE0_URL.
