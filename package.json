{
  "name": "syncverse",
  "private": true,
  "version": "0.1.0",
  "description": "SyncVerse - collaborative real-time code editor for remote STEM education (overnight prototype)",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "build": "npm run build -w web",
    "smoke": "node scripts/smoke.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify:samples": "node scripts/verify-samples.mjs",
    "e2e": "node scripts/e2e-editor.mjs",
    "e2e:video": "node scripts/e2e-video.mjs",
    "e2e:entry": "node scripts/e2e-entry.mjs",
    "e2e:golden": "node scripts/e2e-golden.mjs",
    "e2e:a11y": "node scripts/e2e-a11y.mjs",
    "test:persist": "node scripts/test-persist.mjs",
    "test:rooms": "node scripts/test-accounts-rooms.mjs",
    "e2e:rooms": "node scripts/e2e-rooms.mjs",
    "check:livekit": "node scripts/check-livekit.mjs",
    "e2e:reconnect": "node scripts/e2e-reconnect.mjs",
    "e2e:whiteboard": "node scripts/e2e-whiteboard.mjs",
    "e2e:snippets": "node scripts/e2e-snippets.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "concurrently": "^9.2.0",
    "playwright-core": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
